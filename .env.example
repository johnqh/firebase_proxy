# firebase-china-proxy — Bun server configuration
#
# Copy to .env for local development (`bun run dev` picks it up
# automatically — Bun loads .env from the working directory).
# In production these come from Doppler via sudobility_dockerized,
# NOT from a .env file. The Cloudflare Worker variant uses
# worker/.dev.vars instead (see worker/.dev.vars.example).

# Port the HTTP server listens on.
# Required. sudobility_dockerized's add.sh reads this from Doppler and
# wires it into the Traefik loadbalancer + healthcheck.
PORT=8080

# Comma-separated Firebase Web API key(s) this proxy will serve.
# Requests to the googleapis prefixes (/identitytoolkit, /securetoken,
# /remoteconfig, /installations) whose key (query param `key` or
# `x-goog-api-key` header) is not in this list get a 403.
# Find yours in Firebase console -> Project settings -> Web API Key.
# Not confidential (it ships in every client bundle).
# OPEN MODE: leaving this unset or empty disables the check entirely —
# the proxy will forward ANY Firebase project's traffic. Convenient for
# serving many projects without listing keys, but it makes the proxy an
# open relay to googleapis.com: abuse can burn the server's IP/domain
# reputation, which is exactly what China reachability depends on.
ALLOWED_API_KEYS=AIzaSyExample1,AIzaSyExample2

# Comma-separated web origins allowed for CORS, or * for any.
# If a request's Origin is not in the list, the first entry is used
# in Access-Control-Allow-Origin (effectively denying the caller).
ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
